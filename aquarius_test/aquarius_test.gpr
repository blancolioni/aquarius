with "config/aquarius_test_config.gpr";

project Aquarius_Test is

   for Source_Dirs use ("src", "config");
   for Object_Dir use "obj/" & Aquarius_Test_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../bin";
   for Main use ("tests.adb");

   package Compiler is
      for Default_Switches ("ada") use Aquarius_Test_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("ada") use ("-Es"); --  Symbolic traceback
   end Binder;

end Aquarius_Test;
