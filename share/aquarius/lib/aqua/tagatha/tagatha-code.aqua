class
   Tagatha.Code

create
   Make

feature

   Make
      do
         Driver.Initialize
      end

   Dispose
      do
         Driver.Dispose
      end

   Push_Constant (Value : Integer)
      do
         Driver.Set_integer_2 (0)
         Driver.Send_Integer (7, Value)
      end

   Push_Real_Constant (Value : Real)
      do
         --  A command of its own, not Push_Constant with a content flag: the
         --  bit pattern needs both argument slots, leaving nowhere to put the
         --  flag.
         Driver.Send_Real (47, Value)
      end

   Pop_Local (Index   : Integer
              Content : Integer)
      do
         Driver.Send_Integer_2 (11, Index, Content)
      end

   Begin_Routine (Name      : String
                  Arg_Count : Integer
                  Is_Public : Boolean)
      do
         Driver.Set_Integer (Arg_Count)
         if Is_Public then
            Driver.Set_Integer_2 (1)
         else
            Driver.Set_Integer_2 (0)
         end
         Driver.Set_String (Name)
         Driver.Set_Command (12)
      end

   End_Routine
      do
         Driver.Set_Command (13)
      end

   Next_Label : Label
      do
         Result := Driver.Next_Label
      end

   Named_Label (Name : String) : Label
      do
         Result := Driver.Named_Label (Name)
      end

   Set_Label (L : Label)
      do
         Driver.Set_Label (L)
      end

   Source_Location (Line   : Integer
                    Column : Integer)
      do
         Driver.Source_Location (Line, Column)
      end

   Push_Argument (Index   : Integer
                  Content : Integer)
      do
         Driver.Send_Integer_2 (8, Index, Content)
      end

   Pop_Argument (Index   : Integer
                 Content : Integer)
      do
         Driver.Send_Integer_2 (10, Index, Content)
      end

   Push_Local (Index     : Integer
               Content   : Integer
               Reference : Boolean)
      local
         Flags : Integer
      do
         Flags := Content
         if Reference then
            Flags := Flags + 2
         end
         Driver.Send_Integer_2 (9, Index, Flags)
      end

   Drop
      do
         Driver.Send_Command (14)
      end

   Pop
      do
         Driver.Send_Command (15)
      end

   Duplicate
      do
         Driver.Send_Command (16)
      end

   Swap
      do
         Driver.Send_Command (17)
      end

   Operate (Op : Integer)
      do
         Driver.Send_Integer (18, Op)
      end

   Convert_To (Content : Integer)
      do
         --  Convert the value on top of the stack to Content (0 = general
         --  word, 1 = floating point).  Converting to the content it already
         --  has costs nothing: the peephole pass drops the move.
         --
         --  Named Convert_To, not Convert as on the Ada side: 'convert' is an
         --  Aqua keyword (it ends a feature_alias), so a feature cannot use it.
         Driver.Send_Integer (48, Content)
      end

   Branch (Condition : Integer
           L         : Label)
      do
         Driver.Send_Integer_2 (19, Condition, L.Label_Index)
      end

   Branch_Always (L : Label)
      do
         Driver.Send_Integer (20, L.Label_Index)
      end

   Call (Name         : String
         Arg_Count    : Integer
         Result_Count : Integer)
      do
         Driver.Send_String_2 (21, Arg_Count, Result_Count, Name)
      end

   Indirect_Call (Arg_Count    : Integer
                  Result_Count : Integer)
      do
         Driver.Send_Integer_2 (22, Arg_Count, Result_Count)
      end

   Jump (Name : String)
      do
         Driver.Send_String (23, Name)
      end

   Pop_Result (Index   : Integer
               Content : Integer)
      do
         Driver.Send_Integer_2 (24, Index, Content)
      end

   Push_Return (Index   : Integer
                Content : Integer)
      do
         Driver.Send_Integer_2 (25, Index, Content)
      end

   Dereference (Content : Integer
                Offset  : Integer)
      do
         Driver.Send_Integer_2 (34, Offset, Content)
      end

   Pop_Indirect (Content : Integer
                 Offset  : Integer)
      do
         Driver.Send_Integer_2 (35, Offset, Content)
      end

   Push_Name (Name    : String
              Extern  : Boolean
              Address : Boolean
              Content : Integer)
      local
         Flags : Integer
      do
         Flags := 0
         if Extern then
            Flags := Flags + 1
         end
         if Address then
            Flags := Flags + 2
         end
         Driver.Send_String_2 (36, Flags, Content, Name)
      end

   Pop_Name (Name    : String
             Extern  : Boolean
             Content : Integer)
      local
         Flags : Integer
      do
         Flags := 0
         if Extern then
            Flags := Flags + 1
         end
         Driver.Send_String_2 (37, Flags, Content, Name)
      end

   Exit_Routine
      do
         Driver.Send_Command (26)
      end

   Fail_Routine
      do
         Driver.Send_Command (27)
      end

   Retry_Routine
      do
         Driver.Send_Command (28)
      end

   Raise_Exception
      do
         Driver.Send_Command (29)
      end

   Add_Local : Integer
      do
         Driver.Send_Command (30)
         Result := Driver.Get_Integer
      end

   Remove_Local
      do
         Driver.Send_Command (31)
      end

   Begin_Block
      do
         Driver.Send_Command (32)
      end

   End_Block
      do
         Driver.Send_Command (33)
      end

   Data_Label (Name : String)
      do
         Driver.Send_String (38, Name)
      end

   Data_Label_RW (Name : String)
      do
         Driver.Send_String (39, Name)
      end

   Data_Int (Value : Integer)
      do
         Driver.Send_Integer (40, Value)
      end

   Data_RW (Value : Integer)
      do
         Driver.Send_Integer (41, Value)
      end

   Data_Ref (Name : String)
      do
         Driver.Send_String (42, Name)
      end

   String_Constant (Value : String)
      do
         Driver.Send_String (43, Value)
      end

   Exception_Handler (Start_Label   : String
                      End_Label     : String
                      Handler_Label : String)
      do
         Driver.Send_String (44, Start_Label)
         Driver.Send_String (45, End_Label)
         Driver.Send_String (46, Handler_Label)
      end

feature { None }

   Driver : Tagatha.Driver

end
