expanded class
   Ast.Operator

--  Op codes for Tagatha.Code.Operate, mirroring the ordinals of
--  Tagatha.Operator (tagatha/src/tagatha.ads). Single source of truth
--  so IR nodes never carry magic integers.
--
--  The float ops are the arithmetic four only. Negate, Modulo and the six
--  comparisons need no float variant: the backend picks the sign flip, frem,
--  fcmp and feql from the content of their operands.

feature

   Identity      : Integer do Result := 0  end
   Negate        : Integer do Result := 1  end
   Logical_Not   : Integer do Result := 2  end
   Test          : Integer do Result := 3  end

   Add           : Integer do Result := 4  end
   Subtract      : Integer do Result := 5  end
   Multiply      : Integer do Result := 6  end
   Divide        : Integer do Result := 7  end
   Modulo        : Integer do Result := 8  end

   Float_Add      : Integer do Result := 9  end
   Float_Subtract : Integer do Result := 10 end
   Float_Multiply : Integer do Result := 11 end
   Float_Divide   : Integer do Result := 12 end

   Bit_And       : Integer do Result := 13 end
   Bit_Or        : Integer do Result := 14 end
   Bit_Xor       : Integer do Result := 15 end

   Dereference   : Integer do Result := 16 end
   Store         : Integer do Result := 17 end

   Compare_Equal     : Integer do Result := 18 end
   Compare_Not_Equal : Integer do Result := 19 end
   Less          : Integer do Result := 20 end
   Less_Equal    : Integer do Result := 21 end
   Greater       : Integer do Result := 22 end
   Greater_Equal : Integer do Result := 23 end

end
