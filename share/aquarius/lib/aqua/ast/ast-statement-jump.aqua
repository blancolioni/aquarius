class
   Ast.Statement.Jump

inherit
   Ast.Statement

create
   Make

--  Non-local jump: transfer to a named routine without returning (a tail
--  transfer / non-local goto). Unlike Statement.Call, control does not come
--  back.

feature

   Make
     (P   : Ast
      Src : Aquarius.Trees.Program_Tree
      N   : String)
      do
         Parent := P
         Source := Src
         Name := N
      end

   Generate (Code : Tagatha.Code)
      do
         Code.Jump (Name)
      end

   Name : String

end
