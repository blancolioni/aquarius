--  A growable, contiguous, integer-indexed sequence backed by a raw word block.
--  Elements must be word-representable (a reference, or a 32-bit expanded value),
--  which holds for every current Aqua type. Indexing is 1-based.

class
   Aqua.Containers.Vector [Element]

inherit
   Aqua.Containers.Sequence [Element]
      redefine default_create end
   Aqua.Containers.Indexable [Element]
      redefine default_create end

create
   default_create

feature  --  creation

   default_create
      local
         Cap : System.Word_32
      do
         Item_Count := 0
         Cap.Convert_From (Initial_Capacity)
         create Store.Allocate_Count (Cap)
      end

feature  --  Container

   Is_Empty : Boolean
      do
         Result := Item_Count = 0
      end

   Contains (Value : Element) : Boolean
      local
         Index : Integer
      do
         from
            Index := 1
         until
            Result or else Index > Item_Count
         loop
            if Item (Index) = Value then
               Result := True
            end
            Index := Index + 1
         end
      end

feature  --  Collection status

   Can_Include : Boolean
      do
         Result := True
      end

   Can_Delete : Boolean
      do
         Result := True
      end

feature  --  Measurement

   Lower : Integer
      do
         Result := 1
      end

   Upper : Integer
      do
         Result := Item_Count
      end

   Occurrences (Value : Element) : Integer
      local
         Index : Integer
      do
         from
            Index := 1
         until
            Index > Item_Count
         loop
            if Item (Index) = Value then
               Result := Result + 1
            end
            Index := Index + 1
         end
      end

feature  --  Indexed access

   Item (Index : Integer) : Element
      require
         In_Range: Index >= 1 and then Index <= Item_Count
      local
         W    : System.Word_32
         A    : System.Address
         Conv : System.Address_To_Object_Conversions [Element]
      do
         W := Store.Get (Word_Offset (Index))
         A.Convert_From (W)
         Result := Conv.To_Object (A)
      end

   Put (Index : Integer; Value : Element)
      require
         In_Range: Index >= 1 and then Index <= Item_Count
      do
         Store_At (Index, Value)
      end

feature  --  Sequence query

   First_Element : Element
      require
         Not_Empty: not Is_Empty
      do
         Result := Item (1)
      end

   Last_Element : Element
      require
         Not_Empty: not Is_Empty
      do
         Result := Item (Item_Count)
      end

feature  --  Element change

   Append (Value : Element)
      local
         Capacity : Integer
      do
         Capacity.Convert_From (Store.Count)
         if Item_Count >= Capacity then
            Grow
         end
         Item_Count := Item_Count + 1
         Store_At (Item_Count, Value)
      end

   Insert (Value : Element)
      do
         Append (Value)
      end

   Include (Value : Element)
      do
         Append (Value)
      end

feature  --  Deletion

   Delete_First
      require
         Not_Empty: not Is_Empty
      do
         Delete_At (1)
      end

   Delete (Value : Element)
      local
         Index : Integer
         Found : Boolean
      do
         from
            Index := 1
         until
            Found or else Index > Item_Count
         loop
            if Item (Index) = Value then
               Delete_At (Index)
               Found := True
            else
               Index := Index + 1
            end
         end
      end

   Delete_All (Value : Element)
      local
         Index : Integer
      do
         from
            Index := 1
         until
            Index > Item_Count
         loop
            if Item (Index) = Value then
               Delete_At (Index)
            else
               Index := Index + 1
            end
         end
      end

   Clear
      do
         Item_Count := 0
      ensure
         Cleared: Is_Empty
      end

feature { None }  --  implementation

   Initial_Capacity : Integer
      do
         Result := 4
      end

   Item_Count : Integer

   Store : System.Memory.Block_32

   Word_Offset (Index : Integer) : System.Word_32
      do
         Result.Convert_From (Index - 1)
      end

   Store_At (Index : Integer; Value : Element)
      local
         A    : System.Address
         W    : System.Word_32
         Conv : System.Address_To_Object_Conversions [Element]
      do
         A := Conv.To_Address (Value)
         W.Convert_From (A)
         Store.Put (Word_Offset (Index), W)
      end

   Delete_At (Index : Integer)
      require
         In_Range: Index >= 1 and then Index <= Item_Count
      local
         I : Integer
      do
         from
            I := Index
         until
            I >= Item_Count
         loop
            Store_At (I, Item (I + 1))
            I := I + 1
         end
         Item_Count := Item_Count - 1
      end

   Grow
      local
         New_Store : System.Memory.Block_32
         New_Count : System.Word_32
      do
         New_Count := Store.Count * 2
         create New_Store.Allocate_Count (New_Count)
         Store.Copy (New_Store, 0)
         Store := New_Store
      end

end
