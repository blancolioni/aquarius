--  A Map implemented as a linked list of (key, value) entries. Linear-time
--  lookup; intended for small maps. Composes a Linked_List rather than
--  inheriting it, to avoid the two-Container-instantiation clash.

class
   Aqua.Containers.List_Map [Key_Type, Element_Type]

inherit
   Aqua.Containers.Map [Key_Type, Element_Type]
      redefine default_create end

create
   default_create

feature

   default_create
      do
         create Entries
      end

feature  --  Container

   Is_Empty : Boolean
      do
         Result := Entries.Is_Empty
      end

   Contains (E : Element_Type) : Boolean
      do
         across Entries as Item
         until Result
         loop
            Result := Item.Second = E
         end
      end

feature  --  Map query

   Contains_Key (K : Key_Type) : Boolean
      do
         across Entries as Item
         until Result
         loop
            Result := Item.First = K
         end
      end

   Element (K : Key_Type) : Element_Type
      local
         Found : Boolean
      do
         across Entries as Item
         until Found
         loop
            if Item.First = K then
               Found := True
               Result := Item.Second
            end
         end
      end

feature  --  Map change

   Insert (K : Key_Type; E : Element_Type)
      do
         Entries.Append ((K, E))
      end

   Delete (K : Key_Type)
      local
         It : Aqua.Containers.Linked_List_Iterator [(Key_Type, Element_Type)]
         Found : Boolean
      do
         from
            It := Entries.New_Cursor
         until
            Found or else It.After
         loop
            if It.Element.First = K then
               It.Delete
               Found := True
            else
               It.Next
            end
         end
      end

feature { None }

   Entries : Aqua.Containers.Linked_List [(Key_Type, Element_Type)]

end
