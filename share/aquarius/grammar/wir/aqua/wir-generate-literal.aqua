class
   Wir.Generate.Literal

inherit
   Wir.Generate.Expr_Node

--  A signed integer literal (Ast.Expression.Literal) or a signed real one
--  (Ast.Expression.Real_Literal, which sets its own float content).

feature

   After_Signed_Integer (Child : Wir.Generate.Signed_Integer)
      do
         Value := Child.Value
      end

   After_Signed_Real (Child : Wir.Generate.Signed_Real)
      do
         Real_Value := Child.Value
         Is_Real := True
      end

   After_Node
      local
         L : Ast.Expression.Literal
         R : Ast.Expression.Real_Literal
      do
         if Is_Real then
            create R.Make_Real (Void, Current, Real_Value)
            Set_Expr (R)
         else
            create L.Make_Integer (Void, Current, Value)
            Set_Expr (L)
         end
      end

feature { None }

   Value      : Integer
   Real_Value : Real
   Is_Real    : Boolean

end
