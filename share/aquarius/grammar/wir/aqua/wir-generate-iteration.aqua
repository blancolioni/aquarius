class
   Wir.Generate.Iteration

inherit
   Wir.Generate.Stmt_Node

--  'loop' expression 'do' <body> 'end' 'loop'. Pre-tested loop
--  (Ast.Statement.Iteration).

feature

   After_Expression (Child : Wir.Generate.Expression)
      do
         Condition := Child.Expr
      end

   After_Statement_List (Child : Wir.Generate.Statement_List)
      do
         Body := Child.Stmt
      end

   After_Node
      local
         I : Ast.Statement.Iteration
      do
         if attached Condition as Cond then
            if attached Body as B then
               create I.Make (Void, Current, Cond, B)
               Set_Stmt (I)
            end
         end
      end

feature { None }

   Condition : detachable Ast.Expression
   Body      : detachable Ast.Statement

end
