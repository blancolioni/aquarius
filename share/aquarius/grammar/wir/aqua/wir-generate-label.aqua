class
   Wir.Generate.Label

inherit
   Wir.Generate.Stmt_Node

--  'label' name. A routine-scoped label definition (Ast.Statement.Label).

feature

   After_Name (Child : Wir.Generate.Name)
      do
         Nm := Child.Concatenated_Image
      end

   After_Node
      local
         L : Ast.Statement.Label
      do
         if attached Nm as N then
            create L.Make (Void, Current, N)
            Set_Stmt (L)
         end
      end

feature { None }

   Nm : detachable String

end
