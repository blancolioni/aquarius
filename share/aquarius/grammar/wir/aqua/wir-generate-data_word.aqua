class
   Wir.Generate.Data_Word

inherit
   Wir.Generate.Data_Node

--  [ 'rw' ] 'word' <signed integer>. One word of data; 'rw' makes it
--  writable (Ast.Data.Word / Make_RW).

feature

   After_Data_Scope (Child : Wir.Generate.Data_Scope)
      do
         if Child.Concatenated_Image = "rw" then
            Is_RW := True
         end
      end

   After_Signed_Integer (Child : Wir.Generate.Signed_Integer)
      do
         Value := Child.Value
      end

   After_Node
      local
         D : Ast.Data.Word
      do
         if Is_RW then
            create D.Make_RW (Void, Current, Value)
         else
            create D.Make (Void, Current, Value)
         end
         Set_Datum (D)
      end

feature { None }

   Value : Integer
   Is_RW : Boolean

end
