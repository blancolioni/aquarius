class
   Wir.Generate.Lvalue

inherit
   Wir.Generate.Expr_Node

--  Dispatch node for the assignable expressions. The chosen alternative's
--  expression is consumed by Assign via Set_Value. An optional ': float' tag
--  follows, as on an expression: Set_Value pops by Content, so without it a
--  store to a double would write one word.

feature

   After_Argument (Child : Wir.Generate.Argument)
      do Copy (Child.Expr) end

   After_Local_Variable (Child : Wir.Generate.Local_Variable)
      do Copy (Child.Expr) end

   After_Result_Slot (Child : Wir.Generate.Result_Slot)
      do Copy (Child.Expr) end

   After_Store_Name (Child : Wir.Generate.Store_Name)
      do Copy (Child.Expr) end

   After_Dereference (Child : Wir.Generate.Dereference)
      do Copy (Child.Expr) end

   After_Content (Child : Wir.Generate.Content)
      do
         Is_Float := True
      end

   After_Node
      do
         if Is_Float then
            --  'attached X as Y' has to stand alone; it cannot be the right
            --  operand of and then, hence the nested if.
            if attached Expr as E then
               E.Set_Content (1)
            end
         end
      end

feature { None }

   Is_Float : Boolean

   Copy (E : detachable Ast.Expression)
      do
         if attached E as The_Expression then
            Set_Expr (The_Expression)
         end
      end

end
