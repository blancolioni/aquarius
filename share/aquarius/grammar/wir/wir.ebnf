top_level ::= unit

case_sensitive = false

identifier      ::= !\l[\w]*!
--  real MUST stay declared before integer.  The tokeniser takes the first
--  declared class that matches rather than the longest, so integer would match
--  just the "3" of "3.14" and leave ".14" stranded.  ada_numeric_literal is no
--  use here for the same reason: it matches both forms.
real            ::= .standard ada_real_literal
integer         ::= .standard ada_integer_literal
string_constant ::= .standard ada_string_literal
delimiter       ::= .delimiters "()[]+,;&|"
symbol          ::= .standard ada_symbol

line_comment = "--"

.format '(' space_before no_space_after
.format ')' no_space_before space_after
.format '[' space_before no_space_after
.format ']' no_space_before space_after
.format ',' no_space_before space_after
.format ':' space_before space_after
.format ';' no_space_before new_line_after
.format 'is' closing space_before new_line_after
.format 'then' closing space_before space_after
.format 'do' closing space_before space_after
.format 'end' new_line_before
.format routine new_line_before
.format statement new_line_before
.format statement_list indented_child

unit ::= { routine } { data_item }

routine ::=
   'routine' routine_scope name
      'args' integer
      'locals' integer
   'is'
      statement_list
   'end'

routine_scope ::= [ 'public' ]

statement_list ::= { statement }

statement ::= sequence | assign | return_statement | call_statement
            | conditional | iteration | label | goto | jump | fail
            | raise | evaluate | block | retry_statement

sequence ::= 'begin' statement_list 'end' ';'

assign ::= lvalue ':=' expression ';'

return_statement ::= 'return' [ expression ] ';'

call_statement ::= 'call' name '(' [ argument_list ] ')' ';'

conditional ::=
   'if' expression 'then'
      statement_list
   [ 'else'
      statement_list ]
   'end' 'if' ';'

iteration ::=
   'loop' expression 'do'
      statement_list
   'end' 'loop' ';'

label ::= 'label' name ';'
goto  ::= 'goto' name ';'
jump  ::= 'jump' name ';'

fail            ::= 'fail' ';'
raise           ::= 'raise' expression ';'
evaluate        ::= 'eval' expression ';'
retry_statement ::= 'retry' ';'

block ::=
   'block' 'locals' integer
      statement_list
   'end' 'block' ';'

expression ::= primary [ content ]

content ::= ':' 'float'

primary ::= literal
          | argument
          | local_variable
          | result_slot
          | binary
          | unary
          | conversion
          | name_value
          | call_expression
          | indirect_call
          | dereference

literal ::= signed_integer | signed_real

argument       ::= 'arg' integer
local_variable ::= 'local' integer
result_slot    ::= 'result' integer

binary ::= '(' expression binary_operator expression ')'

unary ::= unary_operator expression

--  Change the content of a value: to_float converts an integer to a double,
--  to_word converts back.  Not an operator, because the conversion is in the
--  content rather than the operation (Ast.Expression.Conversion).
conversion ::= conversion_target expression

conversion_target ::= 'to_float' | 'to_word'

name_value ::= addr_opt extern_opt name
addr_opt   ::= [ 'addr' ]
extern_opt ::= [ 'extern' ]

call_expression ::= name '(' [ argument_list ] ')'

indirect_call ::= '*' expression '(' [ argument_list ] ')'

dereference ::= '[' expression [ '+' integer ] ']'

argument_list ::= < expression / ',' >

--  The content tag matters on a target as much as on an expression: a store
--  pops one word or two, and only the tag says which.
lvalue ::= ( argument
           | local_variable
           | result_slot
           | store_name
           | dereference ) [ content ]

store_name ::= extern_opt name

signed_integer ::= [ '-' ] integer

signed_real ::= [ '-' ] real

--  fadd .. fdiv are the only float operators: negate, mod and the comparisons
--  take their float form from the content of their operands instead.
binary_operator ::= '+' | '-'  | '*'   | '/'  | 'mod'
                  | 'fadd' | 'fsub' | 'fmul' | 'fdiv'
                  | '&' | '|'  | 'xor'
                  | '=' | '/=' | '<'   | '<=' | '>' | '>='

unary_operator ::= '+' | 'neg' | 'not' | 'test'

data_item ::= data_label | data_word | data_reference | data_text

data_label ::= data_scope 'data' name ':'

data_word ::= data_scope 'word' signed_integer ';'

data_reference ::= 'ref' name ';'

data_text ::= 'text' string_constant ';'

data_scope ::= [ 'rw' ]

name ::= identifier
