class
   Pascal.Checks.Assignment_Statement

inherit
   Pascal.Checks.Node

--  assignment_statement ::= variable_access ':=' expression. Marks the
--  left-hand variable_access as an assignment target before it reduces, so the
--  cross reference it records is classified as a write rather than a read. The
--  Before hook fires before the child subtree (and its After_Node, where the
--  reference is recorded) runs.
--
--  That is the one piece of information in this plugin that flows DOWNWARD.
--  Everything else flows up, which is why the type check waits for After_Node
--  (issue #88): the target's type arrives when the variable_access reduces and
--  the source's when the expression does, and only then are both in hand.
--
--  Both are copied out as Integer codes rather than the child visitors being
--  kept, which is what #107 warns about and is unnecessary here.
--
--  A whole record or array copy -- Target and Source both Types.Structured_Type
--  AND naming the SAME structure -- is the one place Structured_Type is a
--  legal operand at all: it is otherwise excluded from Is_Known everywhere
--  (an operator, a call argument, a for-loop bound), which stays unchanged.
--  Structure_Index has to travel alongside Ty for this, so Pascal.Checks.
--  Factor/Term/Simple_Expression/Expression each carry it now too, the same
--  "0 unless Ty says structured" contract Variable_Access
--  already keeps -- reset to 0 the moment an operator combines two operands,
--  since no operator ever legally yields a structure.
--
--  A string literal assigned to an array-of-char target -- Target
--  Structured_Type and Source Types.String_Literal_Type -- is the second such
--  place (issue #104's string-literal follow-up): ISO Pascal's rule that a
--  string literal of length n is assignable to any array [1 .. n] of char,
--  matched by SHAPE (element char, one dimension, that length), not by
--  Structure_Index identity the way two structured operands are. Literal_
--  Length travels alongside Ty the same way Structure_Index does, reset to 0
--  the same way.

feature

   Before_Variable_Access (Child : Pascal.Checks.Variable_Access)
      do
         Child.Set_Target
      end

   After_Variable_Access (Child : Pascal.Checks.Variable_Access)
      do
         Target_Type := Child.Ty
         Target_Structure := Child.Structure_Index
      end

   After_Expression (Child : Pascal.Checks.Expression)
      do
         Source_Type := Child.Ty
         Source_Structure := Child.Structure_Index
         Source_Literal_Length := Child.Literal_Length
      end

   After_Node
      local
         T       : Pascal.Checks.Types
         Target  : Integer
         Source  : Integer
         Matched : Boolean
      do
         if T.Is_Structured (Target_Type) and then T.Is_Structured (Source_Type)
         then
            if Target_Structure = Source_Structure then
               Matched := True
            end
         elsif T.Is_Structured (Target_Type)
           and then Source_Type = T.String_Literal_Type
         then
            if Matches_String_Literal (Target_Structure, Source_Literal_Length)
            then
               Matched := True
            end
         end
         if not Matched then
            Target := Check_Known (Target_Type, "an assignment target")
            Source := Check_Known (Source_Type, "an assigned value")
            if not T.Assignable (Target, Source) then
               --  Integer to real is Pascal's one implicit widening; the
               --  other direction is what round and trunc are for.
               Error ("cannot assign " & T.Name (Source) & " to "
                      & T.Name (Target))
            end
         end
      end

feature { None }

   Target_Type           : Integer
   Source_Type           : Integer
   Target_Structure      : Integer
   Source_Structure      : Integer
   Source_Literal_Length : Integer

   Matches_String_Literal (Structure_Idx : Integer; Len : Integer) : Boolean
      --  Whether the array numbered Structure_Idx is a one-dimensional array
      --  of char whose length is exactly Len (issue #104's string-literal
      --  follow-up).
      local
         T   : Pascal.Checks.Types
         Arr : Pascal.Checks.Structure
         Dim : Pascal.Checks.Bounds
      do
         Arr := Current_Frame_Scope.Structure (Structure_Idx)
         if Arr.Is_Array and then Arr.Element_Ty = T.Char_Type then
            if Current_Frame_Scope.Dimension_Count (Structure_Idx) = 1 then
               Dim := Current_Frame_Scope.Dimension (Structure_Idx, 1)
               if Dim.Is_Known and then Dim.Length = Len then
                  Result := True
               end
            end
         end
      end

end
