class
   Pascal.Generate.Variable_Access

inherit
   Pascal.Generate.Expr_Node

--  variable_access ::= variable_identifier { variable_suffix }. The demo
--  handles scalar variables only (no suffixes): resolves the name to its
--  frame-local offset and yields an Ast.Expression.Local_Variable, which
--  serves as both rvalue (Generate) and assignment target (Set_Value).

feature

   After_Variable_Identifier (Child : Pascal.Generate.Variable_Identifier)
      do
         Nm := Child.Concatenated_Image
      end

   After_Node
      local
         L : Ast.Expression.Local_Variable
      do
         if attached Nm as N then
            create L.Make (Void, Current, Scope.Offset (N))
            Set_Expr (L)
         end
      end

feature { None }

   Nm : detachable String

end
