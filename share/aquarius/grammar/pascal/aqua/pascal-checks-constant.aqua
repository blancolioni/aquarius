class
   Pascal.Checks.Constant
inherit
   Pascal.Has_Ast
   Aquarius.Trees.Program_Tree
feature

   After_Numeric_Literal (Literal : String)
      local
         Value : Integer
         Expr  : Ast.Expression.Literal
      do
         Value := Literal.To_Integer
         if Value < 0 then
            Error ("Constant value must not be negative")
         end
         create Expr.Make_Integer (Current, Value)
         Tree := Expr
      end

end