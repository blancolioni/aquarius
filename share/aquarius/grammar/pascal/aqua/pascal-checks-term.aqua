class
   Pascal.Checks.Term

inherit
   Pascal.Checks.Node

--  term ::= < factor / multiplying_operator >. A bare variable only if it is one
--  factor and no operator: x is a variable, x * 2 is not (issue #105).
--
--  Also the rung where '*', '/', 'div', 'mod' and 'and' type their operands
--  (issue #88). The operator reduces between its two factors, so Pending holds
--  the rule to apply until the right-hand factor arrives -- the same shape the
--  code stage uses to hold its Ast operator.

feature

   Is_Variable : Boolean

   Ty : Integer

   Structure_Index : Integer
      --  As Pascal.Checks.Factor's, threaded up when this term is one bare
      --  factor; 0 once an operator has combined two, since no operator ever
      --  legally yields a structure (issue #104).

   Literal_Length : Integer
      --  As Structure_Index, but for a string literal (issue #104's
      --  string-literal follow-up).

   After_Multiplying_Operator (Child : Pascal.Checks.Multiplying_Operator)
      do
         Pending := Child.Kind
      end

   After_Factor (Child : Pascal.Checks.Factor)
      do
         if Factors = 0 then
            Is_Variable := Child.Is_Variable
            Ty := Child.Ty
            Structure_Index := Child.Structure_Index
            Literal_Length := Child.Literal_Length
         else
            Is_Variable := False
            Ty := Combine_Types (Pending, Ty, Child.Ty)
            Structure_Index := 0
            Literal_Length := 0
         end
         Factors := Factors + 1
      end

feature { None }

   Factors : Integer
   Pending : Integer

end
