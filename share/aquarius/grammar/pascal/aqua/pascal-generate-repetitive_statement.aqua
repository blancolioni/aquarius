class
   Pascal.Generate.Repetitive_Statement

inherit
   Pascal.Generate.Stmt_Node

--  repetitive_statement ::= repeat_statement | while_statement | for_statement.
--  repeat (post-tested) is out of demo scope.

feature

   After_While_Statement (Child : Pascal.Generate.While_Statement)
      do
         Copy_Stmt (Child.Stmt)
      end

   After_For_Statement (Child : Pascal.Generate.For_Statement)
      do
         Copy_Stmt (Child.Stmt)
      end

end
