class
   Pascal.Generate.Expr_Node

inherit
   Pascal.Generate.Node

--  A node whose synthesized value is an Ast.Expression.

feature

   Expr : detachable Ast.Expression

   Set_Expr (E : Ast.Expression)
      do
         Expr := E
      end

   Copy_Expr (E : detachable Ast.Expression)
      do
         if attached E as The_Expression then
            Set_Expr (The_Expression)
         end
      end

end
