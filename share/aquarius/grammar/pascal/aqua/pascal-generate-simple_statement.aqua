class
   Pascal.Generate.Simple_Statement

inherit
   Pascal.Generate.Stmt_Node

--  simple_statement ::= assignment_statement | procedure_statement
--                     | goto_statement. goto is out of demo scope.

feature

   After_Assignment_Statement (Child : Pascal.Generate.Assignment_Statement)
      do
         Copy_Stmt (Child.Stmt)
      end

   After_Procedure_Statement (Child : Pascal.Generate.Procedure_Statement)
      do
         Copy_Stmt (Child.Stmt)
      end

end
