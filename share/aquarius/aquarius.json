{
    "version": "0.1.0-dev",
    "extensions": {
		"aqua": {
			"name": "Aqua source",
			"plugin": "aqua"
		},
		"ndy": {
			"name": "Project Normandy",
			"plugin": "normandy"
		},
		"json": {
			"name": "JSON file",
			"plugin": "json"
		},
		"idl": {
			"name": "IDLE interface definition",
			"plugin": "idle"
		},
		"lox": {
			"name": "Lox programming language",
			"plugin": "lox"
		},
		"ob": {
			"name": "Oberon programming language",
			"plugin": "oberon"
		},
		"ada": {
			"name": "Ada programming language",
			"plugin": "ada"
		},
		"adb": {
			"name": "Ada body",
			"plugin": "ada"
		},
		"ads": {
			"name": "Ada specification",
			"plugin": "ada"
		},
		"pas": {
			"name": "Pascal programming language",
			"plugin": "pascal"
		}
    },
    "install": {
		"paths": {
			"temporary": "tmp",
			"standard": "lib/aqua",
			"assembly": "tmp/asm",
			"grammar": "grammar",
			"generated": "tmp/gen",
			"object": "tmp/obj"
		},
		"tools": {
			"as": "./aqua_as/bin/aqua_as"
		}
    },
	"plugins": {

	},
	"filesystem":{
		"data": {
			"path": "./fs",
			"read": true,
			"write": true
		},
		"log": {
			"path": "./log",
			"write": true
		}
	}
}