with "config/aquarius_ui_gtk_config.gpr";
project Aquarius_Ui_Gtk is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Aquarius_Ui_Gtk_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "../bin";
   for Main use ("aquarius-ui-gtk_driver.adb");

   package Compiler is
      for Default_Switches ("Ada")
        use Aquarius_Ui_Gtk_Config.Ada_Compiler_Switches;
   end Compiler;

   package Builder is
      for Executable ("aquarius-ui-gtk_driver.adb") use "aquarius-gtk";
   end Builder;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Aquarius_Ui_Gtk;
